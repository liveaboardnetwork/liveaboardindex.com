{
  "name": "liveaboardindex.com",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build && node --disable-warning=ExperimentalWarning scripts/build.ts",
    "preview": "vite preview",
    "check": "tsc && node --disable-warning=ExperimentalWarning scripts/schema.ts && node --disable-warning=ExperimentalWarning scripts/build.ts --check",
    "new": "node --disable-warning=ExperimentalWarning scripts/new.ts",
    "typecheck": "tsc",
    "schema": "node --disable-warning=ExperimentalWarning scripts/schema.ts",
    "tools:liveaboard": "node --disable-warning=ExperimentalWarning tools/liveaboard/scrape.ts",
    "tools:har": "node --disable-warning=ExperimentalWarning tools/liveaboard/har.ts",
    "tools:typecheck": "tsc -p tools"
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "typescript": "^6.0.3",
    "vite": "^8.0.12",
    "yaml": "^2.9.0",
    "zod": "^4.4.3"
  }
}
