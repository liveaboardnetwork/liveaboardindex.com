{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^lvb_[0-9a-hjkmnp-tv-z]{6}$"
    },
    "names": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^\\S(.*\\S)?$"
          },
          "from": {
            "anyOf": [
              {
                "anyOf": [
                  {
                    "type": "integer",
                    "minimum": 1850,
                    "maximum": 2100
                  },
                  {
                    "type": "string",
                    "pattern": "^(\\d{4})(?:-(\\d{2})(?:-(\\d{2}))?)?$"
                  }
                ]
              },
              {
                "type": "null"
              }
            ]
          },
          "to": {
            "anyOf": [
              {
                "anyOf": [
                  {
                    "type": "integer",
                    "minimum": 1850,
                    "maximum": 2100
                  },
                  {
                    "type": "string",
                    "pattern": "^(\\d{4})(?:-(\\d{2})(?:-(\\d{2}))?)?$"
                  }
                ]
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "name",
          "from",
          "to"
        ],
        "additionalProperties": false
      }
    },
    "hull": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^(steel|wood|aluminium|fiberglass|composite)_(motor|sail|motor_sail)$"
        },
        {
          "type": "null"
        }
      ]
    },
    "built": {
      "type": "object",
      "properties": {
        "year": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1850,
              "maximum": 2028
            },
            {
              "type": "null"
            }
          ]
        },
        "yard": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^\\S(.*\\S)?$"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "year",
        "yard"
      ],
      "additionalProperties": false
    },
    "imo": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 1000000,
          "maximum": 9999999
        },
        {
          "type": "null"
        }
      ]
    },
    "mmsi": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 200000000,
          "maximum": 799999999
        },
        {
          "type": "null"
        }
      ]
    },
    "call_sign": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[A-Z0-9][A-Z0-9-]{2,9}$"
